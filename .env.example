# Copy this file to ".env" and fill ONE of the two options below.

# ---- Option A: IBM watsonx.ai (recommended for IBM SkillsBuild project) ----
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# ---- Option B: Google Gemini (free key, good Hindi) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Optional: real WhatsApp reminders via Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
